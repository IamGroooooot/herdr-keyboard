{
  "name": "herdr-keyboard",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.json && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/cli.js --sourcemap",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "effect": "3.22.2"
  },
  "devDependencies": {
    "@types/node": "24.13.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
